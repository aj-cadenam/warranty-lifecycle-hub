# ══════════════════════════════════════════════════════════════════════════════
# Datecsa Garantías — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# All other defaults live in config/settings.py (single source of truth).
# Copy this file to .env and fill in the values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=garantias
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
DATABASE_URL=postgresql://user:pass@localhost:5432/garantias

# ── Secrets ───────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret
DEBUG=true
DJANGO_SETTINGS_MODULE=config.django_settings

# ── AI Providers ──────────────────────────────────────────────────────────────
# Set to "gemini" to use real Gemini APIs; leave as "fake"/"mock" for tests.
LLM_PROVIDER=fake          # "fake" | "gemini"
EMBEDDING_PROVIDER=fake    # "fake" | "gemini"
EMBEDDING_DIM=768          # Matryoshka — do not change without re-ingesting pgvector
OCR_BACKEND=mock           # "mock" | "gemini"
GEMINI_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=mock         # "mock" | "outlook"
EMAIL_ADDRESS=             # tu-correo@outlook.com
EMAIL_PASSWORD=            # app password (Settings → Security → App passwords)
EMAIL_IMAP_FOLDER=INBOX
EMAIL_POLLING_INTERVAL_MINUTES=5

# Internal contacts — recipients for auto-generated draft emails
RESPONSABLE_GARANTIAS_EMAIL=responsable@datecsafake.com
BODEGA_EMAIL=bodega@datecsafake.com
DESPACHO_EMAIL=despacho@datecsafake.com
RECEPCION_EMAIL=recepcion@datecsafake.com

# ── Business Rules ────────────────────────────────────────────────────────────
TIMEOUT_PROVEEDOR_DIAS=7   # Days without provider response before escalation
TIMEOUT_CLIENTE_DIAS=7     # Days without client response before escalation

# ── Observability (optional) ──────────────────────────────────────────────────
# Activate to trace all LLM calls (decide, classify_email, generate_email, embed, OCR)
# Get keys at https://cloud.langfuse.com → Settings → API Keys
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
